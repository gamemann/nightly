generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// kind: task | issue | check | study | review
/// status: queue | in_progress | review | blocked | done | wontfix
/// addedBy: <owner> | nightly | session
model Item {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  title       String
  body        String    @default("")
  kind        String    @default("task")
  status      String    @default("queue")
  priority    Int       @default(0)
  repos       String    @default("")
  doneWhen    String?
  addedBy     String    @default("owner")
  cadence     String?
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  notes       Note[]
  projects    ItemProject[]

  @@index([status, priority])
  @@index([kind, status])
  @@index([completedAt])
  @@index([updatedAt])
}

model Note {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  runId     Int?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  author    String   @default("owner")
  body      String
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([runId])
}

/// status: running | ok | failed | skipped
/// trigger: cron | manual | import
/// report is what the agent wrote (`nightly run finish --report-file`); log is the runner's
/// own output (guard lines, claude's final message), streamed in by `nightly exec`.
model Run {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running")
  summary    String    @default("")
  report     String    @default("")
  log        String    @default("")
  turns      Int?
  minutes    Float?
  costUsd    Float?
  trigger    String    @default("cron")
  pid        Int?
  scheduleId Int?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  notes      Note[]

  @@index([scheduleId])
  @@index([startedAt])
  @@index([status])
}

/// When and how the runner starts. `nightly tick` (crontab, every minute) fires each enabled
/// schedule whose cron expression matches the minute. prompt is a file under prompt/;
/// instructions are appended to it for this schedule only.
model Schedule {
  id           Int       @id @default(autoincrement())
  name         String
  cron         String
  enabled      Boolean   @default(true)
  prompt       String    @default("nightly.md")
  instructions String    @default("")
  maxTurns     Int       @default(400)
  allowOverlap Boolean   @default(false)
  lastFiredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  runs         Run[]
}

/// A Claude session (nightly run or live session) on the agent board.
/// kind: nightly | session
/// Live while endedAt is null and lastSeenAt is recent; every `nightly agent` call refreshes it.
model Agent {
  id         Int       @id @default(autoincrement())
  name       String
  kind       String    @default("session")
  task       String    @default("")
  repos      String    @default("")
  runId      Int?
  lastReadId Int       @default(0)
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?
  claims     Claim[]
  messages   Message[]

  @@index([name, endedAt])
}

/// A path an agent is working in, relative to the workspace (`website-city`, `game-dev/godot/dot-map`).
/// Two claims overlap when one path is the other or contains it; `*` overlaps everything.
model Claim {
  id         Int       @id @default(autoincrement())
  agentId    Int
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  scope      String
  note       String    @default("")
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  @@index([releasedAt])
  @@index([agentId, releasedAt])
}

/// to: an agent name, or null for everyone. agentId is null for the owner (the panel) and the system.
model Message {
  id        Int      @id @default(autoincrement())
  agentId   Int?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  author    String
  to        String?
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([author])
}

model Setting {
  key   String @id
  value String
}

/// The agent's prompts and the runner script. They live here, not in the repository, because
/// they are specific to one workspace. name is how they are referred to (`nightly.md`,
/// `run.sh`; Schedule.prompt names one). kind: prompt | script
model Prompt {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  kind      String          @default("prompt")
  body      String          @default("")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  versions  PromptVersion[]
}

/// Every saved body of a prompt, newest = current. author: <owner> | nightly | session | import
model PromptVersion {
  id        Int      @id @default(autoincrement())
  promptId  Int
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  body      String
  author    String   @default("owner")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([promptId])
}

/// One QA result pushed from a game machine (POST /api/qa; scripts/qa-post.sh). Panel-only table:
/// the CLI never touches it. kind: fuzz | visual | suite. summary/failures are JSON text; images
/// are files in NIGHTLY_ATTACH/qa-<id>/ (served by /attachments/qa-<id>/<file>).
model QaRun {
  id          Int      @id @default(autoincrement())
  kind        String
  game        String
  commit      String   @default("")
  ranAt       DateTime
  ok          Boolean
  total       Int      @default(0)
  failedCount Int      @default(0)
  summary     String   @default("{}")
  failures    String   @default("[]")
  images      String   @default("[]")
  createdAt   DateTime @default(now())

  @@index([game, kind, ranAt])
  @@index([ranAt])
}

/// A pinned note on a picture or its 3D model. target is an attachment file name of itemKey
/// (the .glb/.gltf for kind "model", the picture for "image"). Model pins: x,y,z in model
/// space plus the surface normal; image pins: x,y fractions of the picture (z and normal 0).
model Annotation {
  id        Int      @id @default(autoincrement())
  itemKey   String
  kind      String
  target    String
  x         Float
  y         Float
  z         Float    @default(0)
  nx        Float    @default(0)
  ny        Float    @default(0)
  nz        Float    @default(0)
  text      String
  author    String   @default("owner")
  createdAt DateTime @default(now())

  @@index([itemKey, target])
}

/// PERFORMANCE tab. A registered game (data-driven, added with `nightly perf game add`, the panel or
/// POST /api/perf/game). budgets: JSON [{metric, max?|min?, platform?, role?, map?, bots?}].
/// routing: JSON {"<platform>:<role>": "<box>"}; addons: JSON {"<span prefix>": "<addon>"}.
/// The perf tables are written by lib/perf-store.mjs (CLI, node:sqlite); the panel only reads them.
/// DDL for an existing database: prisma/migrations/20261120000000_perf/migration.sql (`nightly perf migrate`).
model PerfGame {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  repo       String   @default("")
  repoPath   String   @default("")
  engine     String   @default("godot")
  platforms  String   @default("native,web")
  owner      String   @default("")
  budgets    String   @default("[]")
  routing    String   @default("{}")
  addons     String   @default("{}")
  perfScript String   @default("tools/perf.sh")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One benchmark: a named run with its config. Numbers are in PerfMetric, per-function rows in PerfFunc,
/// raw artefacts (report.json, stacks.folded, report.txt) on disk under <data>/perf/<artefact>.
model PerfRun {
  id            Int          @id @default(autoincrement())
  game          String
  name          String       @default("")
  commit        String       @default("")
  build         String       @default("")
  branch        String       @default("")
  platform      String       @default("native")
  role          String       @default("client")
  map           String       @default("")
  bots          Int          @default(0)
  resolution    String       @default("")
  gpu           String       @default("")
  durationS     Float        @default(0)
  frames        Int          @default(0)
  ranAt         DateTime
  source        String       @default("")
  label         String       @default("")
  reportVersion Int          @default(0)
  artefact      String       @default("")
  createdAt     DateTime     @default(now())
  metrics       PerfMetric[]
  funcs         PerfFunc[]

  @@index([game, ranAt])
  @@index([game, platform, role, map, ranAt])
  @@index([commit])
}

model PerfMetric {
  id    Int     @id @default(autoincrement())
  runId Int
  run   PerfRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name  String
  value Float

  @@index([runId])
  @@index([name, runId])
}

/// A function/span row of a run's profiler table. grp is the budget group (physics | process | render | wait | other),
/// addon the attribution from the game's addons map (else the span's prefix).
model PerfFunc {
  id      Int     @id @default(autoincrement())
  runId   Int
  run     PerfRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name    String
  path    String  @default("")
  per     String  @default("frame")
  grp     String  @default("other")
  addon   String  @default("")
  selfMs  Float   @default(0)
  totalMs Float   @default(0)
  calls   Float   @default(0)

  @@index([runId])
  @@index([name])
}

/// A perf finding and the queue item filed for it (itemKey is an Item.key; its status is read live).
/// One row per game + metric (the dedupe). kind: budget | regression | offender. metric is the budget metric,
/// "regress:<metric>@<scope>" or "fn:<function>". status: open | resolved (is the problem still measured).
/// state is the RSI loop: found -> fixed (item closed done) -> remeasured (a later run in scope), with
/// beforeValue/afterValue the delta; dismissed = item closed wontfix. history keeps earlier completed cycles (JSON list).
model PerfFinding {
  id              Int       @id @default(autoincrement())
  game            String
  metric          String
  runId           Int?
  itemKey         String    @default("")
  status          String    @default("open")
  value           Float     @default(0)
  limit           Float     @default(0)
  note            String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  kind            String    @default("budget")
  state           String    @default("found")
  fn              String    @default("")
  scope           String    @default("")
  beforeValue     Float?
  afterValue      Float?
  fixedAt         DateTime?
  remeasuredRunId Int?
  remeasuredAt    DateTime?
  history         String    @default("[]")

  @@unique([game, metric])
}

/// An ingest token: one per runner and/or game. Only the sha256 of the secret is stored (the secret is shown once, at creation).
/// game "" = any game. Revoked tokens stay as rows.
model PerfToken {
  id         Int       @id @default(autoincrement())
  name       String
  hash       String
  prefix     String    @default("")
  game       String    @default("")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@unique([name])
  @@unique([hash])
}

/// A screenshot (png) attached to a perf run, e.g. the frame at the worst hitch. The file is <perf dir>/shots/<runId>/<file>.
model PerfShot {
  id        Int      @id @default(autoincrement())
  runId     Int
  name      String   @default("")
  note      String   @default("")
  file      String
  bytes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([runId])
}

/// ASSETS (RSI) tab: one row per weapon (or pack-level sound bucket) with its asset audit record. `data` is the audit JSON
/// (model, textures, animations, sounds, flags) plus `_files` (where the glb / texture / sound files live on disk).
/// source: audit (from rsi_asset_audit.py) | scan (the panel's own directory scan; an audit row is never overwritten by a scan).
model AssetWeapon {
  id         Int    @id @default(autoincrement())
  pack       String
  game       String @default("")
  weaponId   String
  kind       String @default("weapon")
  source     String @default("scan")
  tris       Int    @default(0)
  texCount   Int    @default(0)
  animCount  Int    @default(0)
  soundCount Int    @default(0)
  flagCount  Int    @default(0)
  flagCodes  String @default("")
  score      Int    @default(0)
  pass       Int    @default(0)
  auditedAt  String @default("")
  updatedAt  String @default("")
  data       String @default("{}")
  /// Denormalised from `data` so the table pages, sorts and charts in SQL (lib/asset-cols.mjs backfills; shape 0 = not yet).
  hasModel   Int    @default(0)
  verts      Int    @default(0)
  materials  Int    @default(0)
  texMax     Int    @default(0)
  texBytes   Int    @default(0)
  texMaps    String @default("")
  animLen    Float  @default(0)
  soundLen   Float  @default(0)
  soundBytes Int    @default(0)
  /// hash of the model file the cached thumbnail was rendered from; the thumbnail is redone when it changes
  fileHash   String @default("")
  shape      Int    @default(0)
  attachments AssetAttachment[] @relation("AssetParent")
  attachedTo  AssetAttachment[] @relation("AssetAttached")

  @@unique([pack, weaponId])
  @@index([game])
  @@index([kind])
  @@index([pack])
  @@index([score])
  @@index([tris])
  @@index([kind, pack])
}

/// ASSETS: a place assets live (a pack or a game checkout). `name` is what AssetWeapon.pack holds. `config` (JSON) holds the globs
/// for models / textures / animations / sounds, kind rules, weapon definitions and the event table; see lib/assets-sources.mjs.
model AssetSource {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  type       String  @default("pack")
  root       String  @default("")
  repo       String  @default("")
  enabled    Boolean @default(true)
  config     String  @default("{}")
  lastScanAt String  @default("")
  createdAt  String  @default("")
  updatedAt  String  @default("")
}

/// ASSETS: an asset kind (weapon, prop, avatar, ...) with the regex that classifies a path and the audit budget (JSON) for it.
model AssetKind {
  id        Int    @id @default(autoincrement())
  key       String @unique
  label     String @default("")
  sort      Int    @default(0)
  match     String @default("")
  budget    String @default("{}")
  /// Assets tab: entities | avatars | maps | "" (Models)
  tab       String @default("")
  /// 1 = sounds are attached to this kind
  sounds    Int    @default(0)
  updatedAt String @default("")
}

/// RSI board (the Nightly home page): one finding per subject + code + tier. domain: weapons | textures | animations | sounds |
/// maps | process. Asset findings are created and closed by the audit refresh (lib/rsi.mjs); process findings flag stale,
/// duplicate and blocked items. state: found -> fixed (its item is done, awaiting the audit) -> remeasured (the audit
/// no longer flags it; beforeScore/afterScore are the asset's score then and now). status: open | resolved.
model RsiFinding {
  id          Int       @id @default(autoincrement())
  domain      String
  subject     String
  assetId     Int?
  code        String
  tier        String    @default("")
  severity    String    @default("warn")
  msg         String    @default("")
  nextAction  String    @default("")
  state       String    @default("found")
  status      String    @default("open")
  beforeScore Float?
  afterScore  Float?
  itemKey     String    @default("")
  firstSeenAt DateTime
  lastSeenAt  DateTime
  fixedAt     DateTime?
  history     String    @default("[]")

  @@unique([subject, code, tier])
  @@index([domain, status])
}

/// RSI flag definitions: `match` is a regex over an audit flag code; the first row by sort with a domain sets the board domain,
/// the first with an action gives the finding's next action. Generic rows are seeded on create (lib/rsi-flags.mjs).
model RsiFlag {
  id        Int    @id @default(autoincrement())
  match     String @unique
  domain    String @default("")
  action    String @default("")
  label     String @default("")
  sort      Int    @default(0)
  updatedAt String @default("")
}

/// Project-health feeds (lib/feeds.mjs creates the tables; written only by `nightly releases|crash|web|playtest|content`).
model Release {
  id         Int      @id @default(autoincrement())
  game       String   @default("")
  repo       String
  version    String
  channel    String   @default("stable")
  commit     String   @default("")
  ci         String   @default("unknown")
  deployedTo String   @default("")
  changelog  String   @default("")
  rollback   String   @default("")
  at         DateTime

  @@unique([repo, version, channel])
  @@index([at])
}

model CrashGroup {
  id          Int      @id @default(autoincrement())
  game        String
  signature   String
  version     String   @default("")
  platform    String   @default("")
  count       Int      @default(1)
  sample      String   @default("")
  status      String   @default("open")
  firstSeenAt DateTime
  at          DateTime

  @@unique([game, signature, version, platform], map: "CrashGroup_key")
  @@index([at])
}

model WebBudget {
  id     Int    @id @default(autoincrement())
  game   String
  metric String
  max    Float
  unit   String @default("")

  @@unique([game, metric], map: "WebBudget_key")
}

model WebSample {
  id     Int      @id @default(autoincrement())
  game   String
  metric String
  value  Float
  url    String   @default("")
  commit String   @default("")
  at     DateTime

  @@index([game, metric, at], map: "WebSample_game_metric_at")
  @@index([at])
}

model Playtest {
  id     Int      @id @default(autoincrement())
  game   String
  build  String   @default("")
  tester String   @default("")
  rating Int?
  tags   String   @default("")
  text   String   @default("")
  at     DateTime

  @@index([at])
}

model ContentStat {
  id       Int      @id @default(autoincrement())
  game     String
  category String   @default("")
  name     String
  metric   String
  value    Float
  min      Float?
  max      Float?
  at       DateTime

  @@unique([game, category, name, metric], map: "ContentStat_key")
}

/// A weapon (or any asset) -> attachment asset link: mount slot plus the transform in the parent model's space (position m, rotation degrees, scale).
/// `node` names a parent node the mount rides on (a magazine); `meta` carries per-link game data (excludes, zoom, stat scale).
model AssetAttachment {
  id           Int         @id @default(autoincrement())
  parentId     Int
  attachmentId Int
  slot         String
  px           Float       @default(0)
  py           Float       @default(0)
  pz           Float       @default(0)
  rx           Float       @default(0)
  ry           Float       @default(0)
  rz           Float       @default(0)
  sx           Float       @default(1)
  sy           Float       @default(1)
  sz           Float       @default(1)
  node         String      @default("")
  meta         String      @default("{}")
  updatedAt    String      @default("")
  parent       AssetWeapon @relation("AssetParent", fields: [parentId], references: [id], onDelete: Cascade)
  attachment   AssetWeapon @relation("AssetAttached", fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([parentId, attachmentId, slot])
  @@index([attachmentId])
}

/// One row per pack per audit ingest (AssetWeapon keeps only the latest audit per asset).
model AssetAuditHistory {
  id       Int    @id @default(autoincrement())
  at       String
  pack     String
  total    Int    @default(0)
  pass     Int    @default(0)
  avgScore Int    @default(0)

  @@index([pack, at])
}

// ---------------------------------------------------------------------------
// Users, roles and permissions (redesign phase 1). The panel is always behind a login.
// Permission keys are listed in lib/permissions.mjs (PERMISSIONS); `*` and `<area>.*` are wildcards.

/// A panel account. hash is `salt:hash` scrypt hex (lib/passwords.mjs). disabledAt blocks login.
model User {
  id          Int               @id @default(autoincrement())
  username    String            @unique
  name        String            @default("")
  hash        String
  disabledAt  DateTime?
  lastLoginAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  roles       UserRole[]
  grants      PermissionGrant[]
  sessions    Session[]
  access      ProjectAccess[]
  nodeUsers   NodeUser[]
}

/// A named set of permission grants. builtin roles (admin, user) cannot be deleted.
model Role {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String            @default("")
  builtin     Boolean           @default(false)
  createdAt   DateTime          @default(now())
  users       UserRole[]
  grants      PermissionGrant[]
  access      ProjectAccess[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// One permission for a role or a user (exactly one of roleId/userId). allow=false on a user grant
/// removes a permission the user's roles give.
model PermissionGrant {
  id     Int     @id @default(autoincrement())
  roleId Int?
  userId Int?
  perm   String
  allow  Boolean @default(true)
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, perm])
  @@unique([userId, perm])
}

/// A login. The cookie carries a random token; only its sha256 is stored.
model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String   @default("")
  userAgent  String   @default("")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Projects and folders.

/// A folder of projects; folders nest (parentId). icon is a file name under data/icons.
model Folder {
  id        Int             @id @default(autoincrement())
  name      String
  parentId  Int?
  icon      String          @default("")
  sort      Int             @default(0)
  createdAt DateTime        @default(now())
  parent    Folder?         @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]        @relation("FolderTree")
  projects  Project[]
  access    ProjectAccess[]

  @@index([parentId])
}

/// type: website | game | game-addon. settings is JSON (e.g. {"perfGame":"fc"}).
model Project {
  id        Int             @id @default(autoincrement())
  slug      String          @unique
  name      String
  type      String          @default("game")
  repoPath  String          @default("")
  repoUrl   String          @default("")
  folderId  Int?
  icon      String          @default("")
  sort      Int             @default(0)
  settings  String          @default("{}")
  archived  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  folder    Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  access    ProjectAccess[]
  builds    BuildConfig[]
  items     ItemProject[]
  packs     ProjectPack[]
  locStats  LocStat[]

  @@index([folderId])
  @@index([type])
}

/// Gives a user or a role permissions on one project or a whole folder (inherited by subfolders).
/// perms is a comma list of permission keys (`projects.view,tasks.edit`, `*`).
model ProjectAccess {
  id        Int      @id @default(autoincrement())
  projectId Int?
  folderId  Int?
  userId    Int?
  roleId    Int?
  perms     String   @default("projects.view")
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([folderId])
}

// ---------------------------------------------------------------------------
// Nodes (registry only in phase 1; the node daemon lands later).

/// type: planet (runs the panel and agents) | station (build/test box). tokenHash is sha256 of the
/// node token; secret is the shared secret the panel signs with (never shown after creation).
/// specs is JSON: {cpu:{model,mhz,cores,threads}, ram:{gb,type,mhz}, gpu:[], disks:[], buildSlots,
/// heavySlots, offloadKinds:[]}.
model Node {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  type       String     @default("station")
  host       String     @default("")
  port       Int        @default(4001)
  tls        Boolean    @default(false)
  tokenHash  String     @default("")
  secret     String     @default("")
  specs      String     @default("{}")
  /// JSON connection options for the daemon link: {fingerprint, ca, tlsVerify}.
  conn       String     @default("{}")
  status     String     @default("unknown")
  notes      String     @default("")
  lastSeenAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users      NodeUser[]
  linksFrom  NodeLink[] @relation("LinkFrom")
  linksTo    NodeLink[] @relation("LinkTo")
}

/// Maps a panel user onto a login name on a node.
model NodeUser {
  id       Int    @id @default(autoincrement())
  nodeId   Int
  userId   Int
  username String
  node     Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nodeId, userId])
}

/// A link between two nodes. auth: ssh-key | password. status: unknown | ok | failed.
model NodeLink {
  id         Int       @id @default(autoincrement())
  fromId     Int
  toId       Int
  username   String    @default("")
  auth       String    @default("ssh-key")
  status     String    @default("unknown")
  checkedAt  DateTime?
  createdAt  DateTime  @default(now())
  from       Node      @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         Node      @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, username])
}

/// An external database. kind: clickhouse | postgres | mysql | sqlite. secretRef names an env var
/// or file holding the password; the password itself is never stored here.
model DbConnection {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  kind      String   @default("clickhouse")
  host      String   @default("")
  port      Int      @default(0)
  database  String   @default("")
  username  String   @default("")
  secretRef String   @default("")
  options   String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A build of a project. heavy builds run in a node's heavy slots. nodeKinds lists offload kinds
/// a node must offer (comma list).
model BuildConfig {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  command   String   @default("")
  heavy     Boolean  @default(false)
  nodeKinds String   @default("")
  timeout   Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

/// An offload job the panel sent to a node (or kept queued until a node is free). status: queued |
/// running | ok | failed | cancelled. log holds the tail of the output.
model NodeJob {
  id         Int       @id @default(autoincrement())
  jobKey     String    @unique
  nodeId     Int?
  projectId  Int?
  buildId    Int?
  name       String    @default("")
  kind       String    @default("build")
  command    String    @default("")
  heavy      Boolean   @default(false)
  status     String    @default("queued")
  exitCode   Int?
  reason     String    @default("")
  log        String    @default("")
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status])
  @@index([nodeId])
}

// ---- Transcripts (workstream TRANSCRIPTS). DDL twin: lib/transcripts-ddl.mjs. Dates are ISO text. ----

/// One Claude Code session file (main or subagent). Text stays in the file; rows hold metadata and byte ranges.
model Transcript {
  id               Int     @id @default(autoincrement())
  uid              String  @unique
  nodeId           Int?
  osUser           String  @default("")
  sessionId        String
  agentId          String  @default("")
  parentId         Int?
  agentType        String  @default("")
  description      String  @default("")
  toolUseId        String  @default("")
  title            String  @default("")
  cwd              String  @default("")
  projectSlug      String?
  gitBranch        String  @default("")
  model            String  @default("")
  filePath         String  @unique
  offset           Int     @default(0)
  size             Int     @default(0)
  mtimeMs          Int     @default(0)
  startedAt        String  @default("")
  lastAt           String  @default("")
  messageCount     Int     @default(0)
  toolCount        Int     @default(0)
  inTokens         Int     @default(0)
  outTokens        Int     @default(0)
  cacheReadTokens  Int     @default(0)
  cacheWriteTokens Int     @default(0)
  status           String  @default("idle")
  source           String  @default("cli")
  ownerUserId      Int?
  forkedFrom       String  @default("")
  state            String  @default("{}")
  createdAt        String  @default("")
  updatedAt        String  @default("")

  @@index([lastAt])
  @@index([sessionId])
  @@index([parentId])
  @@index([toolUseId])
}

/// One conversation entry of a Transcript: ids, counts and the byte range of its line.
model TranscriptMessage {
  id           Int    @id @default(autoincrement())
  transcriptId Int
  seq          Int
  uuid         String @default("")
  parentUuid   String @default("")
  msgId        String @default("")
  role         String
  kind         String @default("text")
  ts           String @default("")
  byteStart    Int
  byteLen      Int
  model        String @default("")
  sidechain    Int    @default(0)
  meta         Int    @default(0)
  inTok        Int    @default(0)
  outTok       Int    @default(0)
  cacheRead    Int    @default(0)
  cacheWrite   Int    @default(0)
  tools        String @default("[]")
  toolUseIds   String @default("[]")
  spawnIds     String @default("[]")

  @@unique([transcriptId, byteStart])
  @@index([transcriptId, seq])
}

/// A `claude` process the panel or CLI started. status: starting | running | idle | ended | failed.
model TranscriptRun {
  id             Int     @id @default(autoincrement())
  transcriptId   Int?
  sessionId      String  @default("")
  userId         Int?
  osUser         String  @default("")
  nodeId         Int?
  pid            Int     @default(0)
  status         String  @default("starting")
  model          String  @default("")
  effort         String  @default("")
  permissionMode String  @default("default")
  cwd            String  @default("")
  resumeOf       String  @default("")
  dir            String  @default("")
  error          String  @default("")
  exitCode       Int?
  startedAt      String  @default("")
  endedAt        String?

  @@index([status])
  @@index([transcriptId])
}

/// A task belongs to one or more projects (many-to-many). Derived from Item.repos (the recoverable original text) by lib/project-map.mjs;
/// kept in step by item create/edit in the CLI and the panel. via = how the token resolved (slug, alias, rename, path, prefix, text).
model ItemProject {
  id        Int      @id @default(autoincrement())
  itemId    Int
  projectId Int
  via       String   @default("slug")
  token     String   @default("")
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([itemId, projectId])
  @@index([projectId])
}

/// A pack (AssetWeapon.pack / AssetSource.name: a game checkout, a map pack, a weapon or content pack) linked to a project.
/// role: owner (the pack is the project itself, or its renamed twin) | uses (a map or weapon pack the project's game uses). Assets and Maps tabs read this.
model ProjectPack {
  id        Int      @id @default(autoincrement())
  projectId Int
  pack      String
  role      String   @default("owner")
  via       String   @default("slug")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, pack])
  @@index([pack])
}

/// Lines of code of one project at one git sha (scc). Every scan appends a row; the newest row per
/// project is the cache. byLanguage is a JSON array of { name, files, code, comments, blanks }.
model LocStat {
  id         Int      @id @default(autoincrement())
  projectId  Int
  scannedAt  DateTime @default(now())
  code       Int      @default(0)
  comments   Int      @default(0)
  blanks     Int      @default(0)
  total      Int      @default(0)
  files      Int      @default(0)
  byLanguage String   @default("[]")
  sha        String   @default("")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, scannedAt])
}
