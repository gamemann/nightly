generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// kind: task | issue | check | study | review
/// status: queue | in_progress | review | blocked | done | wontfix
/// addedBy: <owner> | nightly | session
model Item {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  title       String
  body        String    @default("")
  kind        String    @default("task")
  status      String    @default("queue")
  priority    Int       @default(0)
  repos       String    @default("")
  doneWhen    String?
  addedBy     String    @default("owner")
  cadence     String?
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  notes       Note[]

  @@index([status, priority])
}

model Note {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  runId     Int?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  author    String   @default("owner")
  body      String
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([runId])
}

/// status: running | ok | failed | skipped
/// trigger: cron | manual | import
/// report is what the agent wrote (`nightly run finish --report-file`); log is the runner's
/// own output (guard lines, claude's final message), streamed in by `nightly exec`.
model Run {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running")
  summary    String    @default("")
  report     String    @default("")
  log        String    @default("")
  turns      Int?
  minutes    Float?
  costUsd    Float?
  trigger    String    @default("cron")
  pid        Int?
  scheduleId Int?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  notes      Note[]

  @@index([scheduleId])
}

/// When and how the runner starts. `nightly tick` (crontab, every minute) fires each enabled
/// schedule whose cron expression matches the minute. prompt is a file under prompt/;
/// instructions are appended to it for this schedule only.
model Schedule {
  id           Int       @id @default(autoincrement())
  name         String
  cron         String
  enabled      Boolean   @default(true)
  prompt       String    @default("nightly.md")
  instructions String    @default("")
  maxTurns     Int       @default(400)
  allowOverlap Boolean   @default(false)
  lastFiredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  runs         Run[]
}

/// A Claude session (nightly run or live session) on the agent board.
/// kind: nightly | session
/// Live while endedAt is null and lastSeenAt is recent; every `nightly agent` call refreshes it.
model Agent {
  id         Int       @id @default(autoincrement())
  name       String
  kind       String    @default("session")
  task       String    @default("")
  repos      String    @default("")
  runId      Int?
  lastReadId Int       @default(0)
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?
  claims     Claim[]
  messages   Message[]

  @@index([name, endedAt])
}

/// A path an agent is working in, relative to the workspace (`website-city`, `game-dev/godot/dot-map`).
/// Two claims overlap when one path is the other or contains it; `*` overlaps everything.
model Claim {
  id         Int       @id @default(autoincrement())
  agentId    Int
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  scope      String
  note       String    @default("")
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  @@index([releasedAt])
}

/// to: an agent name, or null for everyone. agentId is null for the owner (the panel) and the system.
model Message {
  id        Int      @id @default(autoincrement())
  agentId   Int?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  author    String
  to        String?
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

/// The agent's prompts and the runner script. They live here, not in the repository, because
/// they are specific to one workspace. name is how they are referred to (`nightly.md`,
/// `run.sh`; Schedule.prompt names one). kind: prompt | script
model Prompt {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  kind      String          @default("prompt")
  body      String          @default("")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  versions  PromptVersion[]
}

/// Every saved body of a prompt, newest = current. author: <owner> | nightly | session | import
model PromptVersion {
  id        Int      @id @default(autoincrement())
  promptId  Int
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  body      String
  author    String   @default("owner")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([promptId])
}

/// One QA result pushed from a game machine (POST /api/qa; scripts/qa-post.sh). Panel-only table:
/// the CLI never touches it. kind: fuzz | visual | suite. summary/failures are JSON text; images
/// are files in NIGHTLY_ATTACH/qa-<id>/ (served by /attachments/qa-<id>/<file>).
model QaRun {
  id          Int      @id @default(autoincrement())
  kind        String
  game        String
  commit      String   @default("")
  ranAt       DateTime
  ok          Boolean
  total       Int      @default(0)
  failedCount Int      @default(0)
  summary     String   @default("{}")
  failures    String   @default("[]")
  images      String   @default("[]")
  createdAt   DateTime @default(now())

  @@index([game, kind, ranAt])
}

/// A pinned note on a picture or its 3D model. target is an attachment file name of itemKey
/// (the .glb/.gltf for kind "model", the picture for "image"). Model pins: x,y,z in model
/// space plus the surface normal; image pins: x,y fractions of the picture (z and normal 0).
model Annotation {
  id        Int      @id @default(autoincrement())
  itemKey   String
  kind      String
  target    String
  x         Float
  y         Float
  z         Float    @default(0)
  nx        Float    @default(0)
  ny        Float    @default(0)
  nz        Float    @default(0)
  text      String
  author    String   @default("owner")
  createdAt DateTime @default(now())

  @@index([itemKey, target])
}

/// PERFORMANCE tab. A registered game (data-driven, added with `nightly perf game add`, the panel or
/// POST /api/perf/game). budgets: JSON [{metric, max?|min?, platform?, role?, map?, bots?}].
/// routing: JSON {"<platform>:<role>": "<box>"}; addons: JSON {"<span prefix>": "<addon>"}.
/// The perf tables are written by lib/perf-store.mjs (CLI, node:sqlite); the panel only reads them.
/// DDL for an existing database: prisma/migrations/20261120000000_perf/migration.sql (`nightly perf migrate`).
model PerfGame {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  repo       String   @default("")
  repoPath   String   @default("")
  engine     String   @default("godot")
  platforms  String   @default("native,web")
  owner      String   @default("")
  budgets    String   @default("[]")
  routing    String   @default("{}")
  addons     String   @default("{}")
  perfScript String   @default("tools/perf.sh")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One benchmark: a named run with its config. Numbers are in PerfMetric, per-function rows in PerfFunc,
/// raw artefacts (report.json, stacks.folded, report.txt) on disk under <data>/perf/<artefact>.
model PerfRun {
  id            Int          @id @default(autoincrement())
  game          String
  name          String       @default("")
  commit        String       @default("")
  build         String       @default("")
  branch        String       @default("")
  platform      String       @default("native")
  role          String       @default("client")
  map           String       @default("")
  bots          Int          @default(0)
  resolution    String       @default("")
  gpu           String       @default("")
  durationS     Float        @default(0)
  frames        Int          @default(0)
  ranAt         DateTime
  source        String       @default("")
  label         String       @default("")
  reportVersion Int          @default(0)
  artefact      String       @default("")
  createdAt     DateTime     @default(now())
  metrics       PerfMetric[]
  funcs         PerfFunc[]

  @@index([game, ranAt])
  @@index([game, platform, role, map, ranAt])
  @@index([commit])
}

model PerfMetric {
  id    Int     @id @default(autoincrement())
  runId Int
  run   PerfRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name  String
  value Float

  @@index([runId])
  @@index([name, runId])
}

/// A function/span row of a run's profiler table. grp is the budget group (physics | process | render | wait | other),
/// addon the attribution from the game's addons map (else the span's prefix).
model PerfFunc {
  id      Int     @id @default(autoincrement())
  runId   Int
  run     PerfRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name    String
  path    String  @default("")
  per     String  @default("frame")
  grp     String  @default("other")
  addon   String  @default("")
  selfMs  Float   @default(0)
  totalMs Float   @default(0)
  calls   Float   @default(0)

  @@index([runId])
  @@index([name])
}

/// A perf finding and the queue item filed for it (itemKey is an Item.key; its status is read live).
/// One row per game + metric (the dedupe). kind: budget | regression | offender. metric is the budget metric,
/// "regress:<metric>@<scope>" or "fn:<function>". status: open | resolved (is the problem still measured).
/// state is the RSI loop: found -> fixed (item closed done) -> remeasured (a later run in scope), with
/// beforeValue/afterValue the delta; dismissed = item closed wontfix. history keeps earlier completed cycles (JSON list).
model PerfFinding {
  id              Int       @id @default(autoincrement())
  game            String
  metric          String
  runId           Int?
  itemKey         String    @default("")
  status          String    @default("open")
  value           Float     @default(0)
  limit           Float     @default(0)
  note            String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  kind            String    @default("budget")
  state           String    @default("found")
  fn              String    @default("")
  scope           String    @default("")
  beforeValue     Float?
  afterValue      Float?
  fixedAt         DateTime?
  remeasuredRunId Int?
  remeasuredAt    DateTime?
  history         String    @default("[]")

  @@unique([game, metric])
}

/// An ingest token: one per runner and/or game. Only the sha256 of the secret is stored (the secret is shown once, at creation).
/// game "" = any game. Revoked tokens stay as rows.
model PerfToken {
  id         Int       @id @default(autoincrement())
  name       String
  hash       String
  prefix     String    @default("")
  game       String    @default("")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@unique([name])
  @@unique([hash])
}

/// A screenshot (png) attached to a perf run, e.g. the frame at the worst hitch. The file is <perf dir>/shots/<runId>/<file>.
model PerfShot {
  id        Int      @id @default(autoincrement())
  runId     Int
  name      String   @default("")
  note      String   @default("")
  file      String
  bytes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([runId])
}

/// ASSETS (RSI) tab: one row per weapon (or pack-level sound bucket) with its asset audit record. `data` is the audit JSON
/// (model, textures, animations, sounds, flags) plus `_files` (where the glb / texture / sound files live on disk).
/// source: audit (from rsi_asset_audit.py) | scan (the panel's own directory scan; an audit row is never overwritten by a scan).
model AssetWeapon {
  id         Int    @id @default(autoincrement())
  pack       String
  game       String @default("")
  weaponId   String
  kind       String @default("weapon")
  source     String @default("scan")
  tris       Int    @default(0)
  texCount   Int    @default(0)
  animCount  Int    @default(0)
  soundCount Int    @default(0)
  flagCount  Int    @default(0)
  flagCodes  String @default("")
  score      Int    @default(0)
  pass       Int    @default(0)
  auditedAt  String @default("")
  updatedAt  String @default("")
  data       String @default("{}")

  @@unique([pack, weaponId])
  @@index([game])
  @@index([kind])
}

/// ASSETS: a place assets live (a pack or a game checkout). `name` is what AssetWeapon.pack holds. `config` (JSON) holds the globs
/// for models / textures / animations / sounds, kind rules, weapon definitions and the event table; see lib/assets-sources.mjs.
model AssetSource {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  type       String  @default("pack")
  root       String  @default("")
  repo       String  @default("")
  enabled    Boolean @default(true)
  config     String  @default("{}")
  lastScanAt String  @default("")
  createdAt  String  @default("")
  updatedAt  String  @default("")
}

/// ASSETS: an asset kind (weapon, prop, avatar, ...) with the regex that classifies a path and the audit budget (JSON) for it.
model AssetKind {
  id        Int    @id @default(autoincrement())
  key       String @unique
  label     String @default("")
  sort      Int    @default(0)
  match     String @default("")
  budget    String @default("{}")
  updatedAt String @default("")
}

/// RSI board (the Nightly home page): one finding per subject + code + tier. domain: weapons | textures | animations | sounds |
/// maps | process. Asset findings are created and closed by the audit refresh (lib/rsi.mjs); process findings flag stale,
/// duplicate and blocked items. state: found -> fixed (its item is done, awaiting the audit) -> remeasured (the audit
/// no longer flags it; beforeScore/afterScore are the asset's score then and now). status: open | resolved.
model RsiFinding {
  id          Int       @id @default(autoincrement())
  domain      String
  subject     String
  assetId     Int?
  code        String
  tier        String    @default("")
  severity    String    @default("warn")
  msg         String    @default("")
  nextAction  String    @default("")
  state       String    @default("found")
  status      String    @default("open")
  beforeScore Float?
  afterScore  Float?
  itemKey     String    @default("")
  firstSeenAt DateTime
  lastSeenAt  DateTime
  fixedAt     DateTime?
  history     String    @default("[]")

  @@unique([subject, code, tier])
  @@index([domain, status])
}

/// Project-health feeds (lib/feeds.mjs creates the tables; written only by `nightly releases|crash|web|playtest|content`).
model Release {
  id         Int      @id @default(autoincrement())
  game       String   @default("")
  repo       String
  version    String
  channel    String   @default("stable")
  commit     String   @default("")
  ci         String   @default("unknown")
  deployedTo String   @default("")
  changelog  String   @default("")
  rollback   String   @default("")
  at         DateTime

  @@unique([repo, version, channel])
}

model CrashGroup {
  id          Int      @id @default(autoincrement())
  game        String
  signature   String
  version     String   @default("")
  platform    String   @default("")
  count       Int      @default(1)
  sample      String   @default("")
  status      String   @default("open")
  firstSeenAt DateTime
  at          DateTime

  @@unique([game, signature, version, platform], map: "CrashGroup_key")
}

model WebBudget {
  id     Int    @id @default(autoincrement())
  game   String
  metric String
  max    Float
  unit   String @default("")

  @@unique([game, metric], map: "WebBudget_key")
}

model WebSample {
  id     Int      @id @default(autoincrement())
  game   String
  metric String
  value  Float
  url    String   @default("")
  commit String   @default("")
  at     DateTime

  @@index([game, metric, at], map: "WebSample_game_metric_at")
}

model Playtest {
  id     Int      @id @default(autoincrement())
  game   String
  build  String   @default("")
  tester String   @default("")
  rating Int?
  tags   String   @default("")
  text   String   @default("")
  at     DateTime
}

model ContentStat {
  id       Int      @id @default(autoincrement())
  game     String
  category String   @default("")
  name     String
  metric   String
  value    Float
  min      Float?
  max      Float?
  at       DateTime

  @@unique([game, category, name, metric], map: "ContentStat_key")
}
