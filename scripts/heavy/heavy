#!/usr/bin/env bash
# heavy -- run a memory-hungry command in this VM's queue.
#
#   heavy [--lane build|check] [--] <command...>
#   heavy --status
#
# Why: parallel agents each "checked nothing heavy was running" and then all started a
# `next build` / smoke run / Godot suite at once. The guest filled its RAM, the host ran out
# and killed the whole VM (x-tmc-dev01, 2026-10-16). A check-then-start rule is a race;
# this is a lock. The Bash hook (heavy-gate.py) refuses those commands unless they go
# through here. Smoke-class runs additionally wait for an empty agent board (heavy-smoke.py).
# See ~/stack/nightly/scripts/heavy/README.md.
#
# Each job runs in its own systemd scope capped at HEAVY_JOB_MAX_GB (default 12), or at the
# memory free when it starts less HEAVY_JOB_HEADROOM_GB if that is lower, with no swap, so a
# runaway is killed instead of thrashing the VM. It gets HEAVY_JOB_CPUS CPUs at low priority.
#
# Lanes: `build` (next build, smoke, verify, Playwright, Godot suites/imports, cargo and
# docker builds) has HEAVY_SLOTS_BUILD slots, default 1; `check` (tsc, npm run check/lint,
# godot --check-only) has HEAVY_SLOTS_CHECK, default 2. Before starting, it also waits until
# MemAvailable >= HEAVY_MIN_AVAIL_GB. A build slot after the first is taken only while
# MemAvailable >= HEAVY_EXTRA_AVAIL_GB (default the same), and is let go again when it is not,
# so a second suite runs alongside the first only when the memory for it is free now.
# Per-VM values live in /etc/heavy.conf.
#
# Edit this file by writing a copy and `mv`-ing it over: bash reads a script as it runs, and
# /usr/local/bin/heavy is a symlink to it, so an in-place edit breaks every queued job.
#
# The lock is held by this wrapper only (the command gets the fd closed), so a command that
# leaves a daemon behind cannot wedge the queue. A nested `heavy` (a script that calls it
# again) runs straight through instead of deadlocking on its own slot.
set -u

# /etc/heavy.conf holds this VM's defaults; a HEAVY_* already in the environment wins, so
# a one-off `HEAVY_JOB_MAX_GB=20 heavy -- …` is not silently reset by the file.
_heavy_env=
for _v in ${!HEAVY_@}; do _heavy_env+="$_v=${!_v@Q}"$'\n'; done
[ -r /etc/heavy.conf ] && . /etc/heavy.conf
[ -n "$_heavy_env" ] && eval "$_heavy_env"
SLOTS_build=${HEAVY_SLOTS_BUILD:-1}
SLOTS_check=${HEAVY_SLOTS_CHECK:-2}
MIN_AVAIL_GB=${HEAVY_MIN_AVAIL_GB:-4}
# Free memory a build slot beyond the first needs before it is taken. Higher than the first
# slot's, because the job already running may still be growing: on dev02 (11 GB) Godot suites
# peak at 0.5 GB median, 2 GB p99 and 3.5 GB worst (1010 jobs, 2026-10-18), with ~4.5 GB free
# while one runs. Checked at acquisition, not held: a slot it cannot use goes back.
EXTRA_AVAIL_GB=${HEAVY_EXTRA_AVAIL_GB:-$MIN_AVAIL_GB}
# Per-job ceiling (GB) and the swap it may use: past it the job is killed, not the VM
# thrashed. The user slice's MemoryHigh only throttles, so a 17 GB dev server under it
# swapped dev01 for 15 minutes (2026-10-16) instead of dying.
JOB_MAX_GB=${HEAVY_JOB_MAX_GB:-12}
JOB_SWAP_GB=${HEAVY_JOB_SWAP_GB:-0}
# The ceiling is also held under what is free when the job starts, less this headroom: an
# 18 GB ceiling on dev01 with 14 GB already in use (ClickHouse, editors, sessions) let a
# `next build` take the VM to 100% commit and a load of 31 without ever reaching it (2026-10-20).
JOB_HEADROOM_GB=${HEAVY_JOB_HEADROOM_GB:-3}
# CPUs a job may use (CPUQuota), default all but two, and it runs at low CPU/IO priority, so
# the VM still answers while a build has every core busy.
JOB_CPUS=${HEAVY_JOB_CPUS:-$(( $(nproc) > 3 ? $(nproc) - 2 : 1 ))}
DIR=${HEAVY_DIR:-/var/tmp/heavy}
# Optional offload hook (see the wait loop); unset on dev01.
OFFLOAD=${HEAVY_OFFLOAD:-}
OFFLOAD_EVERY=${HEAVY_OFFLOAD_EVERY:-15}

lane=build
while [ $# -gt 0 ]; do
  case $1 in
    --lane) lane=${2:-}; shift 2 ;;
    --lane=*) lane=${1#*=}; shift ;;
    --status)
      mkdir -p "$DIR"
      for f in "$DIR"/*.lock; do
        [ -e "$f" ] || continue
        if ! flock -n "$f" true 2>/dev/null; then
          echo "busy  $(basename "$f" .lock): $(cat "${f%.lock}.who" 2>/dev/null)"
        fi
      done
      echo "MemAvailable: $(awk '/MemAvailable/ {printf "%.1f GB", $2/1048576}' /proc/meminfo) (start needs >= ${MIN_AVAIL_GB} GB; build slots 2-${SLOTS_build} need >= ${EXTRA_AVAIL_GB} GB)"
      exit 0 ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "heavy: no command given (heavy [--lane build|check] -- <command>)" >&2; exit 64; }

case $lane in
  build) slots=$SLOTS_build ;;
  check) slots=$SLOTS_check ;;
  *) echo "heavy: unknown lane '$lane' (build or check)" >&2; exit 64 ;;
esac

# Smoke-class commands (smoke, verify, Playwright) run only when no other agent is live on the
# board: see heavy-smoke.py. Checked before the nested-heavy shortcut, and not when nested (HEAVY_HELD): the outer call already passed. HEAVY_SMOKE=final|force and HEAVY_AGENT are read there.
_hs=$(dirname "$(readlink -f "$0")")/heavy-smoke.py
if [ -z "${HEAVY_HELD:-}" ] && [ -r "$_hs" ] && python3 "$_hs" is-smoke "$@"; then
  python3 "$_hs" check || exit $?
fi

if [ -n "${HEAVY_HELD:-}" ]; then
  exec "$@"
fi

# Route hook, before any slot: the offload script (dev02: gpu.sh) may take the job at once.
# Screenshot tools (tools/screenshot*.sh) always go to a real GPU on a box first, and a game
# suite goes to the boxes first when HEAVY_PREFER_OFFLOAD=1 (the nightly runner). Exit 75
# means "not taken": queue it here as before. GPU_OFFLOAD=0 skips the hook.
if [ -n "$OFFLOAD" ] && [ -x "$OFFLOAD" ] && [ "${GPU_OFFLOAD:-1}" != 0 ]; then
  HEAVY_HELD=offload "$OFFLOAD" route "$@"
  rc=$?
  [ "$rc" != 75 ] && exit "$rc"
fi

mkdir -p "$DIR" 2>/dev/null; chmod 1777 "$DIR" 2>/dev/null
start=$(date +%s); last_note=0; last_offer=0; fd=; slot=
while :; do
  for i in $(seq 1 "$slots"); do
    exec {fd}>>"$DIR/$lane.$i.lock" || exit 70
    if flock -n "$fd"; then
      if [ "$i" -eq 1 ] || [ "$lane" != build ] ||
         [ "$(awk '/MemAvailable/ {print $2}' /proc/meminfo)" -ge $((EXTRA_AVAIL_GB * 1048576)) ]; then
        slot=$i; break 2
      fi
    fi
    exec {fd}>&-
  done
  now=$(date +%s)
  # Offload: a VM may name a script that runs a waiting build-lane job on another machine
  # (dev02: ~/godot/gpu.sh, the laptop "staging"). Offered only while waiting, never instead
  # of a free slot here, because the other machine may be slower per job. Exit 75 means
  # "not taken": keep waiting and offer again in HEAVY_OFFLOAD_EVERY seconds.
  if [ "$lane" = build ] && [ -n "$OFFLOAD" ] && [ -x "$OFFLOAD" ] && [ $((now - last_offer)) -ge "$OFFLOAD_EVERY" ]; then
    last_offer=$now
    HEAVY_HELD=offload "$OFFLOAD" offer "$@"
    rc=$?
    [ "$rc" != 75 ] && exit "$rc"
    now=$(date +%s)
  fi
  if [ $((now - last_note)) -ge 60 ]; then
    echo "heavy: waiting for a $lane slot ($((now - start))s). Held by:" >&2
    for i in $(seq 1 "$slots"); do echo "  $(cat "$DIR/$lane.$i.who" 2>/dev/null)" >&2; done
    last_note=$now
  fi
  sleep 3
done
printf '%s pid %s since %s: %s\n' "$(whoami)@$(hostname -s)" "$$" "$(date +%H:%M:%S)" "$*" | cut -c1-300 > "$DIR/$lane.$slot.who"

last_note=0
while :; do
  avail_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
  [ "$avail_kb" -ge $((MIN_AVAIL_GB * 1048576)) ] && break
  now=$(date +%s)
  if [ $((now - last_note)) -ge 60 ]; then
    echo "heavy: holding $lane/$slot, waiting for ${MIN_AVAIL_GB} GB free (have $((avail_kb / 1048576)) GB)" >&2
    last_note=$now
  fi
  sleep 5
done

waited=$(( $(date +%s) - start ))
[ "$waited" -ge 3 ] && echo "heavy: $lane/$slot acquired after ${waited}s" >&2
# Its own cgroup when the user manager is reachable (the nightly runner and SSH sessions
# may have no user bus): MemoryMax kills the job, MemorySwapMax keeps it out of swap.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
scope=(); job_mb=0; unit=
if [ "$JOB_MAX_GB" != 0 ] && [ -S "$XDG_RUNTIME_DIR/bus" ] && command -v systemd-run >/dev/null; then
  avail_mb=$(( $(awk '/MemAvailable/ {print $2}' /proc/meminfo) / 1024 ))
  job_mb=$(( JOB_MAX_GB * 1024 ))
  fit_mb=$(( avail_mb - JOB_HEADROOM_GB * 1024 ))
  [ "$fit_mb" -lt "$job_mb" ] && job_mb=$fit_mb
  [ "$job_mb" -lt 1024 ] && job_mb=1024
  unit=heavy-$lane-$slot-$$
  scope=(systemd-run --user --scope --quiet --collect --unit="$unit"
         -p MemoryMax="${job_mb}M" -p MemorySwapMax="${JOB_SWAP_GB}G"
         -p CPUQuota="$(( JOB_CPUS * 100 ))%" -p CPUWeight=20 -p IOWeight=20
         -- nice -n 10 ionice -c2 -n7)
  echo "heavy: $lane/$slot: ${job_mb} MB, ${JOB_CPUS} CPUs ($((avail_mb / 1024)) GB free at start)" >&2
fi
# The scope's OOM kills are counted in the user journal; read them to tell its ceiling
# from a kill by somebody else.
oom_before=$(journalctl --user -q -o cat -u "$unit.scope" 2>/dev/null | grep -c 'oom' || true)
HEAVY_HELD=$lane "${scope[@]}" "$@" {fd}>&-
rc=$?
if [ "$rc" = 137 ] && [ ${#scope[@]} -gt 0 ]; then
  oom_after=$(journalctl --user -q -o cat -u "$unit.scope" 2>/dev/null | grep -c 'oom' || true)
  if [ "${oom_after:-0}" -gt "${oom_before:-0}" ]; then
    echo "heavy: killed: it hit its ${job_mb} MB ceiling (HEAVY_JOB_MAX_GB, or less free memory at start)." >&2
  else
    echo "heavy: killed (SIGKILL), not by its ${job_mb} MB ceiling as far as the journal shows: somebody else killed it." >&2
  fi
fi
: > "$DIR/$lane.$slot.who"
exit $rc
