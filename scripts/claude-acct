#!/usr/bin/env bash
# Pick which Claude account a session or nightly run uses. With one account (the default,
# and today's state) every command here is a no-op: nothing is exported and `claude` runs
# exactly as it would without this script.
#
#   claude-acct status            accounts, and each one's 5-hour / 7-day usage (probes; cached 10 min)
#   claude-acct pick              print the name of the account a new session should use
#   claude-acct env               print `export` lines for that account (empty with one account)
#   claude-acct add NAME          create ~/.claude-NAME sharing agents/hooks/skills/settings/projects
#   claude-acct run [claude args] exec claude as the picked account   (also: the name `claude-auto`)
#
# Configuration is environment variables, read from the process or, for the ones below, from an
# env file (first found: $CLAUDE_ACCT_ENV, ~/.config/claude-accounts/env, ~/stack/nightly/.env):
#   CLAUDE_ACCOUNTS         name=config-dir,name=config-dir   (unset or one entry: today's single account)
#   CLAUDE_ACCOUNT          force one account by name
#   CLAUDE_ACCT_FIVE_MAX    skip an account whose 5-hour window is at least this full (default 90)
#   CLAUDE_ACCT_WEEK_MAX    skip an account whose 7-day window is at least this full (default 98)
#   CLAUDE_ACCT_EXCLUDE     account names not to pick (a run that just hit its limit on one)
#   CLAUDE_ACCT_STRICT      1: when no account is under the limits print nothing and exit 1, instead
#                           of falling back to the first one (how a run asks "is there somewhere to spill to?")
# Under `nightly account` the first two come from nightly's settings (accountMaxFiveHour,
# accountMaxWeekly), which win over the env file.
#   CLAUDE_ACCT_TTL         seconds a usage probe is reused (default 600)
# `add` writes CLAUDE_ACCOUNTS into that env file. Only these keys are read from it, never sourced.
#
# Why a pick only at launch: the prompt cache belongs to the account, so switching in the
# middle of a session re-reads the whole context at full price. Sessions here are one batch
# each, so launch is the natural place to choose.
#
# Why the extra dirs symlink projects/: scripts/agent-usage.py and --resume read
# ~/.claude/projects, and per-account copies would split the accounting.
set -uo pipefail

cache="$HOME/.cache/claude-accounts"
usage="${CLAUDE_USAGE_SCRIPT:-$(dirname "$(readlink -f "$0")")/claude-usage.sh}"
mkdir -p "$cache"

envfile=""
for f in "${CLAUDE_ACCT_ENV:-}" "$HOME/.config/claude-accounts/env" "$HOME/stack/nightly/.env"; do
    [ -n "$f" ] && [ -f "$f" ] && { envfile="$f"; break; }
done
if [ -n "$envfile" ]; then   # the process environment wins over the file
    while IFS='=' read -r k v; do
        [ -n "$v" ] && [ -z "${!k:-}" ] && export "$k=$v"
    done < <(grep -E '^(CLAUDE_ACCOUNTS|CLAUDE_ACCOUNT|CLAUDE_ACCT_[A-Z_]+)=' "$envfile")
fi
five_max="${CLAUDE_ACCT_FIVE_MAX:-90}"
week_max="${CLAUDE_ACCT_WEEK_MAX:-98}"
ttl="${CLAUDE_ACCT_TTL:-600}"

accounts() {   # "name dir" lines
    if [ -n "${CLAUDE_ACCOUNTS:-}" ]; then tr ',' '\n' <<<"$CLAUDE_ACCOUNTS" | sed 's/=/ /'
    else echo "default $HOME/.claude"; fi
}
dir_of() { accounts | awk -v n="$1" '$1==n {print $2; exit}' | sed "s|^~|$HOME|"; }

usage_of() {   # name -> "five seven" percent, or "? ?"
    local name="$1" dir f="$cache/$1.json"
    dir="$(dir_of "$name")"
    if [ ! -f "$f" ] || [ $(( $(date +%s) - $(stat -c %Y "$f") )) -gt "$ttl" ]; then
        CLAUDE_CONFIG_DIR="$dir" CLAUDE_USAGE_DEBUG_FILE="$cache/$name.debug" "$usage" --json >"$f.new" 2>/dev/null \
            && mv "$f.new" "$f" || rm -f "$f.new"
    fi
    [ -f "$f" ] && python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
g = lambda k: (d.get(k) or {}).get("percent", "?")
print(g("five_hour"), g("seven_day"))' "$f" || echo "? ?"
}

pick() {
    local strict="${CLAUDE_ACCT_STRICT:-0}"
    if [ -n "${CLAUDE_ACCOUNT:-}" ] && [ "$strict" != 1 ]; then echo "$CLAUDE_ACCOUNT"; return; fi
    local names n all; mapfile -t all < <(accounts | awk '{print $1}')
    names=(); for n in "${all[@]}"; do case ",${CLAUDE_ACCT_EXCLUDE:-}," in *",$n,"*) ;; *) names+=("$n") ;; esac; done
    if [ "${#all[@]}" -le 1 ] && [ "$strict" != 1 ]; then echo "${all[0]:-default}"; return; fi
    local best="" best_week=999 five week
    for n in "${names[@]}"; do
        read -r five week < <(usage_of "$n")
        [ "$five" = "?" ] && continue                          # unknown: only if nothing else answers
        python3 -c "import sys; sys.exit(0 if float('$five') < $five_max and float('$week') < $week_max else 1)" || continue
        if python3 -c "import sys; sys.exit(0 if float('$week') < $best_week else 1)"; then best="$n"; best_week="$week"; fi
    done
    if [ -n "$best" ]; then echo "$best"; elif [ "$strict" = 1 ]; then return 1; else echo "${names[0]:-${all[0]}}"; fi
}

emit_env() {
    local name dir; name="$(pick)" || return 1
    [ "$(accounts | wc -l)" -le 1 ] && [ -z "${CLAUDE_ACCOUNT:-}" ] && return 0
    dir="$(dir_of "$name")"
    [ -n "$dir" ] || { echo "claude-acct: no account named $name" >&2; return 1; }
    echo "export CLAUDE_ACCOUNT='$name'"
    [ "$dir" = "$HOME/.claude" ] && echo "unset CLAUDE_CONFIG_DIR" || echo "export CLAUDE_CONFIG_DIR='$dir'"
}

real_claude() {
    local self c; self="$(readlink -f "$0")"
    for c in "$HOME/.local/bin/claude" "$(command -v claude)"; do
        [ -x "$c" ] && [ "$(readlink -f "$c")" != "$self" ] && { echo "$c"; return; }
    done
    echo "claude-acct: cannot find claude" >&2; return 1
}

cmd="${1:-}"; [ "$(basename "$0")" = "claude-auto" ] && cmd="run" || shift || true
case "$cmd" in
    status)
        while read -r n d; do
            read -r five week < <(usage_of "$n")
            printf '%-12s %-28s 5h %s%%  7d %s%%\n' "$n" "$d" "$five" "$week"
        done < <(accounts)
        echo "next session: $(pick)" ;;
    pick) pick ;;
    env) emit_env ;;
    add)
        name="${1:?usage: claude-acct add NAME}"; dir="$HOME/.claude-$name"
        mkdir -p "$dir"
        for item in agents hooks skills plugins projects settings.json CLAUDE.md; do
            [ -e "$HOME/.claude/$item" ] && [ ! -e "$dir/$item" ] && ln -s "$HOME/.claude/$item" "$dir/$item"
        done
        target="${envfile:-$HOME/.config/claude-accounts/env}"; mkdir -p "$(dirname "$target")"; touch "$target"
        list="${CLAUDE_ACCOUNTS:-default=$HOME/.claude}"
        case ",$list," in *",$name="*) ;; *) list="$list,$name=$dir" ;; esac
        if grep -q '^CLAUDE_ACCOUNTS=' "$target"; then
            python3 -c '
import sys; p, v = sys.argv[1:]
L = [("CLAUDE_ACCOUNTS=" + v) if l.startswith("CLAUDE_ACCOUNTS=") else l for l in open(p).read().split("\n")]
open(p, "w").write("\n".join(L))' "$target" "$list"
        else echo "CLAUDE_ACCOUNTS=$list" >>"$target"; fi
        echo "CLAUDE_ACCOUNTS=$list  (in $target)"
        echo "Created $dir. Sign it in once:  CLAUDE_CONFIG_DIR=$dir claude   (then /login)" ;;
    run)
        eval "$(emit_env)" || exit 1
        exec "$(real_claude)" "$@" ;;
    *) sed -n '2,/^set -uo/p' "$0" | sed '$d'; exit 2 ;;
esac
