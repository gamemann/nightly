# The panel's optional login is set in the panel (Settings -> Login), not here.
# Optional. Absolute path to the SQLite file (default: ./data/nightly.db).
# The CLI, prisma.config.ts and the panel all honour it.
NIGHTLY_DB=
# Optional. Hostnames you open the dev panel by, comma-separated (anything but
# localhost). Without it `npm run dev` never leaves "Loading" from another host.
NIGHTLY_DEV_ORIGINS=
# Optional. "off" stops the panel from checking schedules every minute (then add the
# crontab line from the README, or nothing starts on its own).
NIGHTLY_SCHEDULER=
# Optional. Screenshots directory, laid out <YYYY-MM-DD>/... (default: ./archive/screenshots).
NIGHTLY_MEDIA=
# Optional. A runner script path for `nightly exec`, instead of the run.sh script stored
# in the database (Prompts in the panel; the `runner` setting also sets a path).
NIGHTLY_RUNNER=

# Runner (scripts/run.sh). All optional; see the header of that script.
# The directory of Git repositories the runs work in (default: the parent of this repository).
NIGHTLY_WORKSPACE=
# Commands to warn about when missing, space-separated (default: git node npm).
NIGHTLY_REQUIRED_TOOLS=
# A dirty repository edited this recently (minutes) is left alone as mid-edit (default: 90).
NIGHTLY_IDLE_MINUTES=
# How deep under the workspace to look for repositories (default: 3).
NIGHTLY_REPO_DEPTH=
# The plan-usage check (default: scripts/claude-usage.sh); "off" disables it.
NIGHTLY_USAGE_SCRIPT=
# An executable whose output is added to each run's scope note (your own checks).
NIGHTLY_SCOPE_HOOK=
# The claude binary, and extra arguments for `claude -p` (e.g. --model claude-opus-5-5).
NIGHTLY_CLAUDE_BIN=
NIGHTLY_CLAUDE_ARGS=
# 0 runs claude without --dangerously-skip-permissions (an unattended run then stops at the first prompt).
NIGHTLY_SKIP_PERMISSIONS=
# Where the usage check keeps the raw probe when it cannot parse it (default: data/usage-probe-last.jsonl).
CLAUDE_USAGE_DEBUG_FILE=
