# The panel's optional login is set in the panel (Settings -> Login), not here.
# Optional. Absolute path to the SQLite file (default: ./data/nightly.db).
# The CLI, prisma.config.ts and the panel all honour it.
NIGHTLY_DB=
# Optional. Hostnames you open the dev panel by, comma-separated (anything but
# localhost). Without it `npm run dev` never leaves "Loading" from another host.
NIGHTLY_DEV_ORIGINS=
# Optional. "off" stops the panel from checking schedules every minute (then add the
# crontab line from the README, or nothing starts on its own).
NIGHTLY_SCHEDULER=
# Optional. Screenshots directory, laid out <YYYY-MM-DD>/... (default: ./archive/screenshots).
NIGHTLY_MEDIA=
NIGHTLY_ATTACH=
NIGHTLY_PUBLIC_URL=
# Optional. A runner script path for `nightly exec`, instead of the run.sh script stored
# in the database (Prompts in the panel; the `runner` setting also sets a path).
NIGHTLY_RUNNER=

# Runner (scripts/run.sh). All optional; see the header of that script.
# The directory of Git repositories the runs work in (default: the parent of this repository).
NIGHTLY_WORKSPACE=
# Commands to warn about when missing, space-separated (default: git node npm).
NIGHTLY_REQUIRED_TOOLS=
# A dirty repository edited this recently (minutes) is left alone as mid-edit (default: 90).
NIGHTLY_IDLE_MINUTES=
# How deep under the workspace to look for repositories (default: 3).
NIGHTLY_REPO_DEPTH=
# The plan-usage check (default: scripts/claude-usage.sh); "off" disables it.
NIGHTLY_USAGE_SCRIPT=
# An executable whose output is added to each run's scope note (your own checks).
NIGHTLY_SCOPE_HOOK=
# The claude binary, and extra arguments for `claude -p` (e.g. --model claude-opus-5-5).
NIGHTLY_CLAUDE_BIN=
NIGHTLY_CLAUDE_ARGS=
# 0 runs claude without --dangerously-skip-permissions (an unattended run then stops at the first prompt).
NIGHTLY_SKIP_PERMISSIONS=
# Where the usage check keeps the raw probe when it cannot parse it (default: data/usage-probe-last.jsonl).
CLAUDE_USAGE_DEBUG_FILE=

# Several Claude accounts (scripts/claude-acct, `nightly account`). One account is today's behaviour: leave blank.
# name=config-dir pairs, comma-separated; `nightly account add <name>` writes this line. A run picks the account with
# the lowest 7-day usage whose 5-hour window is under CLAUDE_ACCT_FIVE_MAX, once at its start.
CLAUDE_ACCOUNTS=
# Force one account by name.
CLAUDE_ACCOUNT=
# Skip an account whose 5-hour window is at least this full, percent (default 90).
CLAUDE_ACCT_FIVE_MAX=
# Seconds a usage probe is reused (default 600).
CLAUDE_ACCT_TTL=

# Optional: a machine the runner touches with ssh before and after a run (e.g. to tell an offload box to prefer other work).
# Blank means no ssh call at all. NIGHTLY_OFFLOAD_KEY is an optional ssh identity file.
NIGHTLY_OFFLOAD_HOST=
NIGHTLY_OFFLOAD_KEY=

# Optional. Your name on the board (author of panel notes/messages, default --by). Default "owner".
# Set before `npm run build`: the browser bundle inlines it.
NIGHTLY_OWNER=
# Optional. Other machines scripts/agent-usage.py scans over ssh (comma list).
NIGHTLY_USAGE_HOSTS=
# Optional. bin/docs-claims: the docs site checkout, and a source prefix + ssh host for sources on another machine.
DOCS_CLAIMS_DIR=
DOCS_CLAIMS_REMOTE_PREFIX=
DOCS_CLAIMS_REMOTE_HOST=

# Optional: the Usage tab's long-range store (docker compose up -d clickhouse). Without it the tab reads the local
# SQLite copy. These are NON-SECRET development defaults; change the password before exposing the port beyond localhost.
# Each can also be set in the panel (settings usageChUrl, usageChDb, usageChUser, usageChPasswordEnv); the password is
# only ever read from the environment variable named by usageChPasswordEnv (default NIGHTLY_CLICKHOUSE_PASSWORD).
NIGHTLY_CLICKHOUSE_URL=http://127.0.0.1:8123
NIGHTLY_CLICKHOUSE_DB=nightly_usage
NIGHTLY_CLICKHOUSE_USER=nightly
NIGHTLY_CLICKHOUSE_PASSWORD=nightly-dev-password
# docker compose publishes the port on this address/port (default: localhost only).
NIGHTLY_CLICKHOUSE_BIND=127.0.0.1
NIGHTLY_CLICKHOUSE_PORT=8123

# Installers (Dockerfile, docker-compose.yml, install/install-node.sh).
# First admin, created on the first start when there is no user yet. Leave the password blank to have one generated
# and printed once in the start-up log.
NIGHTLY_ADMIN_USER=admin
NIGHTLY_ADMIN_PASSWORD=
# Where the panel is reached. External: what browsers and other nodes use. Internal: what containers on the compose
# network use. NIGHTLY_BIND / NIGHTLY_PORT are the address the compose file publishes.
NIGHTLY_EXTERNAL_HOST=
NIGHTLY_EXTERNAL_PORT=3010
NIGHTLY_INTERNAL_HOST=panel
NIGHTLY_INTERNAL_PORT=3010
NIGHTLY_BIND=0.0.0.0
NIGHTLY_PORT=3010
# Seconds the bootstrap waits for ClickHouse to answer before it only warns (default 30).
NIGHTLY_BOOTSTRAP_CH_WAIT=
# Node daemon (nightly-node, see install/install-node.sh).
NIGHTLY_NODE_NAME=
NIGHTLY_NODE_PORT=4001
NIGHTLY_NODE_TOKEN=
NIGHTLY_NODE_TLS_CERT=
NIGHTLY_NODE_TLS_KEY=
